# SuperconducTED chart style: Cryostat, dark ground.
# Generated by brand/figures/build_styles.py from brand/tools/palettes.py.
# Do not edit by hand: change palettes.py or the generator and run it again.
#
# Chart roles (roles.json holds them too; superconducted_figures.py draws with them):
#   band fill  #18404B  the interval band, a solid 20 percent tint of the accent
#   band edge  #4FD6E6  the band's bounds (the accent: the range, nothing else)
#   crisp      #EEF3F5  the single-snapshot line, dashed (ink: the machine)
#   measured   #EEF3F5  the hardware's points, ringed in the ground colour
#   series     #D55181 #008300 #9085E9 #C98500 #3987E5 #D95926
#              (magenta, green, violet, yellow, blue, orange; per-qubit identity, fixed order)
#
# Fonts: Space Grotesk for text, Space Mono as the monospace face (tick labels through
# superconducted_figures.mono_ticks); DejaVu Sans and DejaVu Sans Mono, which ship with
# matplotlib, stand in silently where the brand fonts are not installed.

font.family: sans-serif
font.sans-serif: Space Grotesk, DejaVu Sans
font.monospace: Space Mono, DejaVu Sans Mono
font.size: 10
text.color: EEF3F5

figure.facecolor: 0A1B24
figure.edgecolor: 0A1B24
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.1
figure.constrained_layout.w_pad: 0.08
figure.titlesize: 13
figure.titleweight: bold
savefig.facecolor: 0A1B24
savefig.edgecolor: 0A1B24
savefig.dpi: 200
svg.hashsalt: superconducted
pdf.fonttype: 42
ps.fonttype: 42

axes.facecolor: 0A1B24
axes.edgecolor: 5A676D
axes.linewidth: 0.8
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.spines.bottom: True
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.labelcolor: EEF3F5
axes.labelsize: 10
axes.labelpad: 6
axes.titlecolor: EEF3F5
axes.titlesize: 11
axes.titleweight: normal
axes.titlelocation: left
axes.titlepad: 10
axes.prop_cycle: cycler('color', ['D55181', '008300', '9085E9', 'C98500', '3987E5', 'D95926'])

grid.color: 25353D
grid.linestyle: -
grid.linewidth: 0.6
grid.alpha: 1.0

xtick.color: 5A676D
xtick.labelcolor: 9CA5AA
xtick.labelsize: 8.5
xtick.direction: out
xtick.major.size: 3.5
xtick.major.width: 0.8
xtick.minor.visible: False
ytick.color: 5A676D
ytick.labelcolor: 9CA5AA
ytick.labelsize: 8.5
ytick.major.size: 0
ytick.major.pad: 5
ytick.minor.visible: False

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: EEF3F5
legend.handlelength: 1.8
legend.borderaxespad: 0.4

lines.linewidth: 1.5
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.dash_capstyle: butt
lines.dashed_pattern: 3.2, 2.0
lines.markersize: 6
lines.markeredgewidth: 1.2
patch.linewidth: 1.0
